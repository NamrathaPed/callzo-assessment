# Copy to .env to override the development defaults baked into docker-compose.yml.
# NOTE: the simulator signs with callzo_test_secret_change_me, so change
# WEBHOOK_SECRET only if you also change how the simulator is run.
POSTGRES_PASSWORD=change_me
WEBHOOK_SECRET=callzo_test_secret_change_me
API_KEY=change_me
MONTHLY_CAP_CENTS=300
